                "type": "string"
              },
              {
                "const": "PREPARED",
                "type": "string"
              },
              {
                "const": "SUBMITTING",
                "type": "string"
              },
              {
                "const": "SUBMISSION_RESULT_UNKNOWN",
                "type": "string"
              },
              {
                "const": "PENDING",
                "type": "string"
              },
              {
                "const": "CONFIRMED",
                "type": "string"
              },
              {
                "const": "REVERTED",
                "type": "string"
              },
              {
                "const": "NOT_FOUND",
                "type": "string"
              },
              {
