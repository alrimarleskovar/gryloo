            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "entryId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "eventType": {
            "const": "STATE_TRANSITION",
            "type": "string"
          },
          "executionAttemptId": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
