                "type": "string"
              },
              {
                "const": "PARTIALLY_COMPLETED",
                "type": "string"
              },
              {
                "const": "FAILED",
                "type": "string"
              },
              {
                "const": "EXPIRED",
                "type": "string"
              },
              {
                "const": "CANCELLED",
                "type": "string"
              },
              {
