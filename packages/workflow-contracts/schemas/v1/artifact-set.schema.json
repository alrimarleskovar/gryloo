{
  "$id": "urn:defi-workflow-engine:contracts/v1/artifact-set",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifactSetId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactHash": {
            "pattern": "^0x[0-9a-f]{64}$",
            "type": "string"
          },
          "artifactId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "nodeId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          }
        },
        "required": [
          "artifactId",
          "nodeId",
          "artifactHash"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "semanticWorkflowHash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "artifactSetId",
    "semanticWorkflowHash",
    "artifacts"
  ],
  "type": "object"
}
