{
  "name": "defi-workflow-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": "24.21.0", "pnpm": "11.22.0" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages scripts/export-schemas.mjs eslint.config.mjs",
    "test": "vitest run",
    "schemas:export": "node scripts/export-schemas.mjs",
    "schemas:check": "node scripts/export-schemas.mjs --check",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm schemas:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
